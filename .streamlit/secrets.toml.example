# ════════════════════════════════════════════════════════════════════════════
# Configuração de secrets — RedWood Plataforma Reforma Tributária
# ════════════════════════════════════════════════════════════════════════════
# • Local: renomeie este arquivo para `secrets.toml` na pasta `.streamlit/`
# • Streamlit Cloud: cole o conteúdo abaixo em Settings → Secrets
# Todos os campos são opcionais — se vazios, a notificação correspondente
# não é enviada (sem erro).
# ════════════════════════════════════════════════════════════════════════════

# ─── 1) Notificação por E-MAIL (obrigatório para receber alertas) ───────────
# Use uma "Senha de App" do Gmail (não a senha normal):
# https://myaccount.google.com/apppasswords  (precisa ter 2-fatores ativo)
EMAIL_USER = "seu_email@gmail.com"
EMAIL_PASS = "abcd efgh ijkl mnop"

# ─── 2) Notificação por SMS via Twilio (opcional) ───────────────────────────
# Crie conta gratuita: https://www.twilio.com/try-twilio
# Pegue SID + Auth Token no Console Twilio
# TWILIO_SID   = "ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
# TWILIO_TOKEN = "seu_auth_token_aqui"
# TWILIO_FROM  = "+15551234567"           # número Twilio comprado
# SMS_TO       = "+5541985151622"         # destinatário RedWood
